{
  "name": "@rdps/validation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "pnpm --filter @rdps/types build && tsc --noEmit -p tsconfig.json",
    "lint": "eslint src",
    "test": "pnpm --filter @rdps/types build && pnpm build && node --test test/*.test.mjs"
  },
  "dependencies": {
    "@rdps/types": "workspace:*",
    "zod": "^4.6.7"
  }
}
