[Unit]
Description=RDPS coordinated encrypted off-site backup
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=oneshot
User=rdps
SupplementaryGroups=docker
WorkingDirectory=/opt/rdps/current
EnvironmentFile=/etc/rdps/production.env
UMask=0077
ExecStart=/opt/rdps/current/scripts/ops/backup-production.sh
TimeoutStartSec=6h
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
